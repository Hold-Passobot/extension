{
  "manifest_version": 3,
  "name": "Hold Passo doldur",
  "version": "1.2.0",
  "description": "Hold aktarmasında Passolig hesabını doldurur. reCAPTCHA token’ını da Google hesabı açık olan bu Chrome’dan API’ye verir.",
  "action": {
    "default_title": "Hold Passo doldur",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.passo.com.tr/*",
    "https://passo.com.tr/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://localhost:5174/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.passo.com.tr/*", "https://passo.com.tr/*"],
      "js": ["fill.js", "recaptchaKeep.js"],
      "run_at": "document_start"
    }
  ]
}
